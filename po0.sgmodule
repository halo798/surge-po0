#!name=Po0 流量面板
#!desc=显示 Po0 服务器的上行 / 下行 / 剩余流量；切换网络时与每 10 分钟自动把当前网段加入防火墙白名单，@0–@4 锁定白名单位置，面板显示白名单与当前出口
#!category=Po0
#!arguments=USER:必填,PASS:必填,SID:4040,NAME:Po0 腾讯云广州,FW_TOKEN:选填,AUTO_FW:1,FW_NOTIFY:1,INTERVAL:1800
#!arguments-desc=USER / PASS：po0.io 登录邮箱与密码\nSID：服务编号（产品详情页的 #xxxx）\nNAME：面板标题\nFW_TOKEN：控制台「防火墙 → 复制添加脚本」里 pgnfw_ 开头的那一段，不填则不自动加白名单。不写 @ = 不锁定位置；写 @0–@4 = 锁定白名单第 1–5 个位置（pgnfw_xxx@0 = 第 1 个），锁定后永不被淘汰；多台机器用英文逗号分隔\nAUTO_FW：1 = 切换网络时与每 10 分钟自动加入白名单，0 = 关闭\nFW_NOTIFY：1 = 加白名单成功时通知，0 = 只在失败时通知\nINTERVAL：面板自动刷新间隔（秒）

[Panel]
Po0Traffic = script-name=po0-traffic,update-interval={{{INTERVAL}}}
Po0Firewall = script-name=po0-firewall-panel,title="Po0 防火墙",content="点一下刷新",update-interval=600

[Script]
po0-traffic = type=generic,timeout=40,script-path=https://raw.githubusercontent.com/halo798/surge-po0/main/po0.js?v=2026.11.16-3,argument="mode=panel&sid={{{SID}}}&name={{{NAME}}}&user={{{USER}}}&pass={{{PASS}}}"
po0-firewall = type=event,event-name=network-changed,timeout=60,script-path=https://raw.githubusercontent.com/halo798/surge-po0/main/po0.js?v=2026.11.16-3,argument="mode=firewall&enable={{{AUTO_FW}}}&notify={{{FW_NOTIFY}}}&token={{{FW_TOKEN}}}"
po0-firewall-cron = type=cron,cronexp="*/10 * * * *",timeout=60,script-path=https://raw.githubusercontent.com/halo798/surge-po0/main/po0.js?v=2026.11.16-3,argument="mode=firewall&cron=1&enable={{{AUTO_FW}}}&notify={{{FW_NOTIFY}}}&token={{{FW_TOKEN}}}"
po0-firewall-panel = type=generic,timeout=40,script-path=https://raw.githubusercontent.com/halo798/surge-po0/main/po0.js?v=2026.11.16-3,argument="mode=firewall&panel=1&token={{{FW_TOKEN}}}"

[Rule]
# 防火墙接口必须直连，才能把手机真实出口 IP 加入白名单
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve
